# Port the Express server listens on
PORT=3000

# ListenBrainz API root (leave as is)
LISTENBRAINZ_API_URL=https://api.listenbrainz.org

# REQUIRED by ListenBrainz: app name/version plus a way to contact you.
# Format: AppName/version ( contact-email-or-url )
USER_AGENT=ListeningPost/1.0 ( your-email@example.com )

# OPTIONAL: your ListenBrainz user token (https://listenbrainz.org/settings/).
# Public stats work without it; a token only gives higher rate limits.
LISTENBRAINZ_TOKEN=
